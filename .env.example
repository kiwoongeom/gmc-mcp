# --- Required ---

# Your Google Merchant Center account ID (10-digit number, top-right of merchants.google.com).
GMC_ACCOUNT_ID=

# --- Auth (set ONE of these) ---

# Path to a service account JSON key (recommended for self-hosting your own GMC).
# Create at console.cloud.google.com -> IAM & Admin -> Service Accounts -> Keys.
# Then add the service account email as Admin in Merchant Center -> Account access.
GMC_SERVICE_ACCOUNT_KEY=

# Path to an OAuth user-token JSON (for acting on behalf of an end user).
# Create with: gmc-mcp auth-init --client-secrets <client_secret.json>
GMC_OAUTH_TOKEN=

# --- Optional ---

# When operating an MCA (multi-client account), the sub-account ID to act on.
GMC_SUBACCOUNT_ID=

# Append-only audit log of every write operation (JSONL).
GMC_AUDIT_LOG=

# Default page size for list operations (1-1000).
GMC_PAGE_SIZE=100

# Per-request timeout in seconds.
GMC_TIMEOUT=30

# When true, write operations are logged to audit but NOT sent to the API.
GMC_DRY_RUN=false

# Log level for stderr output.
GMC_LOG_LEVEL=INFO

# Transport: stdio (Claude Desktop / Code) or sse (remote / Docker).
GMC_TRANSPORT=stdio
GMC_HOST=127.0.0.1
GMC_PORT=8000
